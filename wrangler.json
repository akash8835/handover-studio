{
  "name": "handover-studio",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "STORE",
      "id": "385aa0ccbd024daebffe7a097c1b31ca"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "PUBLICATIONS",
        "class_name": "PublicationGate"
      },
      {
        "name": "LIBRARY",
        "class_name": "SerializedLibrary"
      },
      {
        "name": "REGISTRY_CONTROL",
        "class_name": "RegistryMode"
      }
    ]
  },
  "migrations": [
    {
      "tag": "publication-gate-v1",
      "new_sqlite_classes": [
        "PublicationGate"
      ]
    },
    {
      "tag": "library-registry-v1",
      "new_sqlite_classes": [
        "SerializedLibrary",
        "RegistryMode"
      ]
    }
  ]
}